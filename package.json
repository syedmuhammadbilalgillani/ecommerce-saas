{
  "name": "ecommerce-saas",
  "private": true,
  "scripts": {
    "build": "node init && turbo run build",
    "dev": "node init && turbo run dev",
    "dev:storefront": "node init && pnpm --filter web dev",
    "dev:merchant": "node init && pnpm --filter merchant-admin dev",
    "dev:platform": "node init && pnpm --filter platform-admin dev",
    "dev:api": "node init && pnpm --filter api dev",
    "start:storefront": "node init && pnpm --filter web start",
    "start:merchant": "node init && pnpm --filter merchant-admin start",
    "start:platform": "node init && pnpm --filter platform-admin start",
    "start:api": "node init && pnpm --filter api start",
    "build:storefront": "node init && pnpm --filter web build",
    "build:merchant": "node init && pnpm --filter merchant-admin build",
    "build:platform": "node init && pnpm --filter platform-admin build",
    "build:api": "node init && pnpm --filter api build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:migrate": "pnpm --filter @repo/db migrate",
    "db:push": "pnpm --filter @repo/db migrate",
    "db:status": "pnpm --filter @repo/db migrate:status",
    "db:check": "pnpm --filter @repo/db check",
    "db:seed": "pnpm --filter @repo/db seed",
    "db:studio": "pnpm --filter @repo/db studio",
    "db:test": "pnpm --filter @repo/db test",
    "db:reset": "pnpm --filter @repo/db reset",
    "db:create-user": "pnpm --filter @repo/db create-user",
    "db:reset-password": "pnpm --filter @repo/db reset-password"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.6",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.11.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@9.15.4"
}

# ==============================================================================
# POSflow Single Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env in the monorepo root:
#   cp .env.example .env
#
# All apps (API, DB scripts, Admin apps, Storefront) load from this single file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by @repo/db (Drizzle ORM) and apps/api.
#
# Option A: Neon Cloud PostgreSQL (Requires SSL)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Option B: Local PostgreSQL (Uncomment below and comment Option A if running locally)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/posflow

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION (apps/api)
# ------------------------------------------------------------------------------
# Port for the NestJS / Fastify API server
PORT=4000

# Application environment ('development' | 'production' | 'test')
NODE_ENV=development

# Logging level ('fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace')
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins for cookie-based auth
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8000

# Proxy Trust: Set to the number of upstream proxies (e.g. 1 if behind Nginx or Next.js rewrites)
# Avoid setting to 'true' in production to prevent IP spoofing
TRUST_PROXY=false

# Rate Limiting: Max requests per minute per IP (default: 300)
RATE_LIMIT_PER_MINUTE=300

# Temporarily disable rate limiting during local automated testing ('true' | 'false')
RATE_LIMIT_DISABLED=false

# ------------------------------------------------------------------------------
# 3. FRONTEND NEXT.JS PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
# Used by apps/web (Storefront), apps/merchant-admin, and apps/platform-admin

# Base URL of the POSflow Backend API
API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000

# Default Store Identifier used by the storefront for product listing & cart
NEXT_PUBLIC_STORE_ID=store_default

# Storefront Application URL
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000

# Merchant Admin Dashboard URL
NEXT_PUBLIC_MERCHANT_ADMIN_URL=http://localhost:3001

# Platform Admin (Super Admin) Dashboard URL
NEXT_PUBLIC_PLATFORM_ADMIN_URL=http://localhost:3002

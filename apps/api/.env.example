# Copy to apps/api/.env (and DATABASE_URL to packages/db/.env). Never commit real values.

# PostgreSQL connection string. Neon: include ?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/posflow

PORT=4000
NODE_ENV=development

# Origins allowed to call the API from a browser (the storefront calls it directly).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Store served when a storefront request has no x-store-id header.
DEFAULT_STORE_ID=store_default

# Number of proxies in front of the API (e.g. 1 = admin app rewrite, 2 = + load balancer).
# Rate limits use the client IP from X-Forwarded-For only through this many hops.
TRUST_PROXY=

# Default requests per minute per IP for routes without their own limit.
RATE_LIMIT_PER_MINUTE=300

# pino log level: fatal | error | warn | info | debug
LOG_LEVEL=info

# Optional: share session cookies across subdomains (normally unset).
COOKIE_DOMAIN=
